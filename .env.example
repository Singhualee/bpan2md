# ============================================================
# bpan2md 配置。复制成 .env 之后填自己的值。
# 这个文件里有账号凭据，别提交到 git、别发群里。
# ============================================================

# ---------- 百度网盘（必填）----------
# 浏览器登录 pan.baidu.com 后按 F12 → Network → 刷新 → 点任意一个请求
# → Request Headers → 复制整条 Cookie，粘到下面（一整行，不用管换行）
BAIDU_COOKIE=
# 转存到自己网盘时用的中转目录，脚本不会删它，事后你可手动清理
BAIDU_TRANSFER_DIR=/bpan2md_中转

# ---------- 转写后端（选一个）----------
# bailian      = 阿里云百炼录音文件识别：便宜、准、支持说话人分离，
#                但需要一个公网 URL（所以要配下面的 OSS）
# siliconflow  = 硅基流动：直接上传文件、不用托管，SenseVoiceSmall 等目前免费，
#                但没有逐句时间戳
ASR_BACKEND=bailian

# --- 百炼 ---
DASHSCOPE_API_KEY=
# 模型选择（价格与能力都已按官方文档核对进 bp2md/models.py）：
#   paraformer-v2   0.288 元/小时  ✅支持说话人分离  ← 最便宜，且支持分离
#   fun-asr         0.792 元/小时  ✅支持说话人分离  （多语种及方言）
#   qwen3-asr-flash-filetrans  0.792 元/小时  ❌不支持分离（固定开启情感识别）
#   qwen-audio-3.1-asr-flash-filetrans  按 token  ✅支持分离（官方推荐）
#
# 重要：**说话人分离不是加价项**，计费只按音频秒数。最便宜的 paraformer-v2
# 本身就支持分离，所以不需要"单说话人用便宜模型、多说话人用贵模型"。
#
#   paraformer-v2                     最便宜，且支持说话人分离
#   qwen3-asr-flash-filetrans         不支持分离
#   qwen-audio-3.1-asr-flash-filetrans 支持分离，按 token 计费
BAILIAN_MODEL=paraformer-v2
# 想区分说话人时打开。开启后单段上限会自动收紧到 2 小时（官方建议）。
BAILIAN_DIARIZATION=true
# 官方示例里 language_hints 只用于 qwen-audio 系列；其它模型会自动跳过
BAILIAN_LANGUAGE_HINTS=zh,en

# ---------- AI 内容总结（可选）----------
# 转写完成后，使用同一个百炼 Key 生成 Markdown 顶部的「内容总结」和「内容大纲」。
# false 可关闭，避免文本模型调用；模型名称必须是你的百炼账号实际可用的模型 ID。
AI_SUMMARY=true
SUMMARY_MODEL=qwen3.8-flash

# --- 硅基流动（如果把 ASR_BACKEND 改成 siliconflow）---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE=https://api.siliconflow.cn/v1
# 官方价格页显示这些语音模型目前免费：
#   FunAudioLLM/SenseVoiceSmall、Qwen/Qwen3-ASR-1.7B、
#   XingChenAGI/XingChenASR-Diarize-V3.0（这个带说话人分离）
SILICONFLOW_MODEL=FunAudioLLM/SenseVoiceSmall

# ---------- 公网托管（bailian 后端需要）----------
# 音频要先放到一个公网能访问的 http(s) 地址上，转写服务才拉得到。
# 脚本内置阿里云 OSS 上传（自己实现签名，不需要装 oss2）。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_AK_ID=
OSS_AK_SECRET=
OSS_PREFIX=bpan2md
# 保持私有：脚本生成一条有效期 7 天的临时签名 URL，供云端转写读取。
OSS_PUBLIC_READ=false
# OSS_PUBLIC_READ=false 时签名 URL 的有效期（秒），默认 7 天
OSS_URL_EXPIRES=604800
# true：转写完就把 OSS 上的音频删掉（默认 false，保留着方便失败重跑不用重传）
OSS_CLEANUP=false

# 如果你已经有别的公网托管（自己的服务器 / 别的对象存储），
# 填一个公共前缀就会跳过 OSS 上传，直接拼 URL
PUBLIC_BASE_URL=
# 配合上一项：把音频拷贝到哪个本地目录（该目录需由你的服务器对外提供）
PUBLIC_LOCAL_DIR=

# ---------- 媒体处理 ----------
# 抽音频参数：16kHz 单声道 32kbps mp3 ≈ 每小时 14MB
AUDIO_BITRATE=32k
AUDIO_SAMPLERATE=16000
AUDIO_CHANNELS=1
# 单段上限，超过就自动切片（百炼 2GB/12h；听悟 6GB/6h。默认按较严的来）
MAX_SEGMENT_SECONDS=21600
MAX_SEGMENT_BYTES=2147483648
# 如果 ffmpeg 不在 PATH 里，填绝对路径
FFMPEG=ffmpeg
FFPROBE=ffprobe

# ---------- 其它（一般不用改）----------
# 百炼接口地址。如果你的账号用的是新版「业务空间」域名，把 {WorkspaceId} 换成实际值，
# 形如 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE=https://dashscope.aliyuncs.com/api/v1
# 轮询间隔（秒）与单次转写任务的最长等待（秒）
POLL_INTERVAL=15
POLL_TIMEOUT=14400
# 中间产物和输出目录。留空就用 bpan2md/work 和 bpan2md/output；
# 想放到别的盘（比如下载几十 GB）可以填绝对路径
BPAN2MD_WORKDIR=
BPAN2MD_OUTDIR=
